@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(ZLIB)
if(@RMRENDER_BUILD_LINUX@)
    list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_dependency(PDFium MODULE)
    find_dependency(PkgConfig)
    pkg_check_modules(RMR_CAIRO REQUIRED IMPORTED_TARGET cairo>=1.16 pangocairo>=1.50 gdk-pixbuf-2.0)
    if(@RMRENDER_BUILD_RMLINES@)
        pkg_check_modules(RMR_PANGO REQUIRED IMPORTED_TARGET pangoft2 fontconfig harfbuzz>=3.3)
    endif()
endif()
if(@RMRENDER_BUILD_RMLINES@)
    find_dependency(RMLines CONFIG)
endif()
if(@RMRENDER_BUILD_RMDOC@)
    find_dependency(RMDoc CONFIG)
endif()
if(@RMRENDER_BUILD_RMMARKS@)
    find_dependency(RMMarks CONFIG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/RMRenderTargets.cmake")
foreach(suffix "" _text _document _marks)
    if(TARGET RMRender::linux${suffix} AND NOT TARGET RMRender::cairo${suffix})
        add_library(RMRender::cairo${suffix} ALIAS RMRender::linux${suffix})
    endif()
endforeach()
check_required_components(RMRender)
