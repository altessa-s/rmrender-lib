prefix=${pcfiledir}/@RMR_PC_PREFIX@
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@
Name: rmrender-linux
Description: @PROJECT_DESCRIPTION@ (linux)
Version: @PROJECT_VERSION@
Requires: rmrender-core
Requires.private: cairo pangocairo gdk-pixbuf-2.0
Libs: -L${libdir} -lrmrender_linux
# PDFium is not installed with rmrender; static users pass -L for its SDK.
Libs.private: @RMR_PC_PDFIUM@
Cflags: -I${includedir}@RMR_PC_CFLAGS@
